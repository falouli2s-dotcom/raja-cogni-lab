@startuml CogniRaja_Activite

skinparam backgroundColor #FAFAFA
skinparam ActivityBorderColor #1B4332
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBarColor #2D6A4F
skinparam ActivityArrowColor #40916C
skinparam ActivityStartColor #1B4332
skinparam ActivityEndColor #1B4332
skinparam NoteBackgroundColor #F0FFF4
skinparam NoteBorderColor #95D5B2
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam swimlaneBorderColor #74C69D
skinparam swimlaneBackgroundColor #F8FFF9

title CogniRaja — Diagramme d'Activité\nFlux complet d'une session de tests cognitifs

|#D8F3DC| Joueur |
|#B7E4C7| Système (React + Supabase) |

|Joueur|
start

:Accéder à l'application CogniRaja;

|Système (React + Supabase)|
:Vérifier l'état d'authentification\n(Supabase Auth + JWT);

if (Utilisateur connecté ?) then (Non)
  |Joueur|
  :Saisir email et mot de passe;
  |Système (React + Supabase)|
  :Valider les identifiants\n(Supabase Auth);
  if (Identifiants valides ?) then (Non)
    |Joueur|
    :Afficher message d'erreur;
    stop
  else (Oui)
    :Créer session JWT;
  endif
else (Oui)
  :Charger profil utilisateur\n(table : profiles);
endif

:Vérifier le rôle de l'utilisateur\n(profiles.role);

if (Rôle ?) then (player)
  |Joueur|
  :Accéder à l'accueil joueur (/app/home);
else (coach)
  :Rediriger → /coach/dashboard;
  stop
else (coach_pending)
  :Rediriger → /pending\n(attente approbation admin);
  stop
else (admin)
  :Rediriger → /admin/coaches;
  stop
endif

|Joueur|
:Consulter les sessions assignées\nou démarrer une nouvelle session;

if (Session assignée par le coach ?) then (Oui)
  :Sélectionner la session assignée;
else (Non)
  :Cliquer sur "Démarrer une session";
endif

|Système (React + Supabase)|
:Créer une entrée sessions_test\n(status = pending);
:Afficher l'écran d'introduction\nde la session (SessionManager);

' ─────────────── TEST 1 : SIMON TASK ───────────────
|Joueur|
:Lire les instructions du Simon Task;
:Cliquer sur "Commencer le test";

|Système (React + Supabase)|
:Initialiser SimonEngine\n(préparer essais congruents/incongruents);

repeat
  :Afficher stimulus (flèche + position);
  |Joueur|
  :Appuyer sur la touche\n(gauche/droite);
  |Système (React + Supabase)|
  :Enregistrer TR et exactitude de l'essai;
repeat while (Essais restants ?) is (Oui)
->Non;

:Calculer métriques Simon :\n• avgRT (temps de réaction moyen)\n• simonEffect (RT incongruent − RT congruent)\n• accuracy (% réponses correctes);
:Sauvegarder dans resultats_test\n(test_type = 'simon');

' ─────────── TRANSITION ─────────────────────────────
|Joueur|
:Voir l'écran de transition\n(résumé intermédiaire + pause);

' ─────────── TEST 2 : N-BACK 2 ──────────────────────
:Lire les instructions du N-Back 2;
:Cliquer sur "Commencer le test";

|Système (React + Supabase)|
:Initialiser NBackEngine\n(N=2, séquence de lettres/positions);

repeat
  :Afficher stimulus (lettre ou position);
  |Joueur|
  :Répondre "Match" ou ne pas répondre;
  |Système (React + Supabase)|
  :Enregistrer hits, misses, false alarms;
repeat while (Stimuli restants ?) is (Oui)
->Non;

:Calculer métriques N-Back :\n• accuracy (%)\n• targetErrorRate (%)\n• dPrime (sensibilité signal);
:Sauvegarder dans resultats_test\n(test_type = 'nback');

' ─────────── TRANSITION ─────────────────────────────
|Joueur|
:Voir l'écran de transition\n(résumé intermédiaire + pause);

' ─────────── TEST 3 : TMT A+B ───────────────────────
:Lire les instructions du TMT;
:Commencer la Partie A\n(relier 1→2→3→...→25);

|Système (React + Supabase)|
:Chronométrer la Partie A (timeA);

|Joueur|
:Connecter les cercles en ordre numérique;

|Système (React + Supabase)|
if (Partie A complète ?) then (Oui)
  :Arrêter chronomètre Partie A;
  |Joueur|
  :Commencer la Partie B\n(alterner 1→A→2→B→3→C→...);
  |Système (React + Supabase)|
  :Chronométrer la Partie B (timeB);
  |Joueur|
  :Connecter en alternant chiffres et lettres;
  |Système (React + Supabase)|
  :Arrêter chronomètre Partie B;
else (Temps max dépassé)
  :Enregistrer temps partiel;
endif

:Calculer métriques TMT :\n• timeA (ms)\n• timeB (ms)\n• ratioBA = timeB / timeA;
:Sauvegarder dans resultats_test\n(test_type = 'tmt');

' ─────────── CALCUL SGS ─────────────────────────────
:Lancer le calcul du Score Global Synthétique\n(SGSEngine.computeSGS());

note right
  Calcul des 5 dimensions (score 0-100) :
  • Temps de Réaction   (11%) ← Simon avgRT
  • Contrôle Inhibiteur (17%) ← effet Simon
  • Mémoire de Travail  (22%) ← N-Back accuracy
  • Attention Sélective (22%) ← TMT-A temps
  • Flexibilité Cognitive (28%) ← TMT ratio B/A
end note

:Mettre à jour sessions_test.score_global;

' ─────────── RECOMMANDATIONS ────────────────────────
:Analyser les scores par dimension\n(règles seuils);

if (Flexibilité faible ?\n(ratio B/A > 2.5)) then (Oui)
  :Recommander exercices\nde changement de tâches;
endif

if (Mémoire faible ?\n(erreurs N-Back > 30%)) then (Oui)
  :Recommander exercices\ndual-task / séquences;
endif

if (Inhibition faible ?\n(effet Simon > 80ms)) then (Oui)
  :Recommander exercices\nstop-signal / décision pression;
endif

if (TR lent ?\n(avgRT > 450ms)) then (Oui)
  :Recommander exercices\nstimulus-réponse / réaction balle;
endif

:Charger exercices recommandés\n(filtrage sur indicateur_cognitif);

' ─────────── AFFICHAGE RÉSULTATS ─────────────────────
|Joueur|
:Voir l'écran de résultats finaux\n(SessionResultsScreen) :\n• Score SGS global\n• Profil radar des 5 dimensions\n• Liste des exercices recommandés;

if (Exporter le rapport PDF ?) then (Oui)
  |Système (React + Supabase)|
  :Générer le PDF\n(PDFExportEngine — jsPDF + html2canvas);
  |Joueur|
  :Télécharger le rapport PDF;
else (Non)
endif

|Joueur|
:Fin de la session;

stop

@enduml

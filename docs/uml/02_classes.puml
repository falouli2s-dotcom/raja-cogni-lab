@startuml CogniRaja_Classes

skinparam backgroundColor #FAFAFA
skinparam ClassBorderColor #1B4332
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #D8F3DC
skinparam ArrowColor #40916C
skinparam NoteBackgroundColor #F0FFF4
skinparam NoteBorderColor #95D5B2
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBorderColor #74C69D
skinparam packageBackgroundColor #F8FFF9
skinparam ClassAttributeIconSize 0

title CogniRaja — Diagramme de Classes

' ═══════════════════════════════════════════════════
' PACKAGE : Utilisateurs
' ═══════════════════════════════════════════════════
package "Utilisateurs" {

  abstract class Utilisateur {
    + id : UUID
    + email : String
    + fullName : String
    + role : RoleEnum
    + club : String
    + createdAt : DateTime
    --
    + seConnecter() : void
    + seDeconnecter() : void
    + reinitialiserMotDePasse() : void
    + modifierProfil() : void
  }

  class Joueur {
    + position : String
    + dateNaissance : Date
    --
    + demarrerSession() : Session
    + consulterResultatsSGS() : ScoreSGS[]
    + consulterExercicesRecommandes() : Exercice[]
    + completerExercice(planningId: UUID) : void
    + exporterRapportPDF() : Blob
  }

  class Coach {
    + statutApprobation : String
    --
    + consulterRoster() : Joueur[]
    + assignerSession(joueur: Joueur) : SessionPlanifiee
    + creerPlanEntrainement() : PlanEntrainement
    + consulterProfilCognitif(joueur: Joueur) : ScoreSGS[]
    + exporterRapportJoueur(joueur: Joueur) : Blob
  }

  class Admin {
    --
    + approuverCoach(coach: Coach) : void
    + refuserCoach(coach: Coach) : void
    + listerCoaches() : Coach[]
  }

  enum RoleEnum {
    player
    coach
    coach_pending
    admin
  }

  Utilisateur <|-- Joueur
  Utilisateur <|-- Coach
  Utilisateur <|-- Admin
  Utilisateur --> RoleEnum : role

  class RelationCoachJoueur {
    + coachId : UUID
    + joueurId : UUID
    + createdAt : DateTime
  }
  Coach "1" -- "0..*" RelationCoachJoueur
  Joueur "1" -- "0..*" RelationCoachJoueur
}

' ═══════════════════════════════════════════════════
' PACKAGE : Sessions & Tests
' ═══════════════════════════════════════════════════
package "Sessions & Tests" {

  class Session {
    + id : UUID
    + joueurId : UUID
    + coachId : UUID
    + status : StatusEnum
    + scoreGlobal : Float
    + donneesBrutes : JSON
    + createdAt : DateTime
    --
    + demarrer() : void
    + terminer() : void
    + calculerSGS() : ScoreSGS
  }

  enum StatusEnum {
    pending
    completed
  }

  abstract class Test {
    + id : UUID
    + sessionId : UUID
    + testType : TestTypeEnum
    + startedAt : DateTime
    + completedAt : DateTime
    --
    + {abstract} initialiser() : void
    + {abstract} traiterEssai(essai: Essai) : ResultatEssai
    + {abstract} calculerMetriques() : ResultatTest
  }

  class TestSimon {
    + nbEssais : Integer
    + ratioIncongruents : Float
    --
    + initialiser() : void
    + traiterEssai(essai: EssaiSimon) : ResultatEssai
    + calculerMetriques() : ResultatTest
    ' Métriques : avgRT, simonEffect, accuracy
  }

  class TestNBack {
    + niveauN : Integer
    + nbStimuli : Integer
    --
    + initialiser() : void
    + traiterEssai(essai: EssaiNBack) : ResultatEssai
    + calculerMetriques() : ResultatTest
    ' Métriques : accuracy, targetErrorRate, dPrime
  }

  class TestTMT {
    + partieA : Boolean
    + partieB : Boolean
    --
    + initialiser() : void
    + traiterEssai(essai: EssaiTMT) : ResultatEssai
    + calculerMetriques() : ResultatTest
    ' Métriques : timeA, timeB, ratioBA
  }

  enum TestTypeEnum {
    simon
    nback
    tmt
  }

  class ResultatTest {
    + id : UUID
    + sessionId : UUID
    + testType : TestTypeEnum
    + metrique : String
    + valeur : Float
    + details : JSON
    + createdAt : DateTime
    --
    + sauvegarder() : void
  }

  Session "1" *-- "3" Test : contient
  Session --> StatusEnum : status
  Test <|-- TestSimon
  Test <|-- TestNBack
  Test <|-- TestTMT
  Test --> TestTypeEnum : testType
  Test "1" --> "1" ResultatTest : produit

  note bottom of ResultatTest
    metrique :
    • "simon_effect" (ms) → valeur Simon
    • "target_error_rate" (%) → valeur N-Back
    • "ratio_ba" → valeur TMT
    Données complémentaires dans details (JSON)
  end note
}

' ═══════════════════════════════════════════════════
' PACKAGE : Score Global Synthétique
' ═══════════════════════════════════════════════════
package "Score Global Synthétique (SGS)" {

  class ScoreSGS {
    + global : Integer
    + date : DateTime
    + dimensions : DimensionCognitive[]
    --
    + calculer(scores: TestScores) : ScoreSGS
    + getStatutGlobal() : StatutEnum
  }

  class DimensionCognitive {
    + key : String
    + label : String
    + score : Integer
    + raw : Float
    + unit : String
    + status : StatutEnum
    --
    ' Clés : reactionTime, inhibition,
    ' workingMemory, flexibility, attention
  }

  enum StatutEnum {
    excellent
    normal
    limite
    faible
  }

  ScoreSGS "1" *-- "5" DimensionCognitive
  DimensionCognitive --> StatutEnum : status
  Session "1" --> "1" ScoreSGS : génère

  note right of ScoreSGS
    Poids des dimensions :
    • Flexibilité Cognitive   28%  (TMT B/A)
    • Attention Sélective     22%  (TMT-A temps)
    • Mémoire de Travail      22%  (N-Back accuracy)
    • Contrôle Inhibiteur     17%  (effet Simon)
    • Temps de Réaction       11%  (Simon avgRT)
    [Anticipation Perceptuelle : réservé v2]
  end note
}

' ═══════════════════════════════════════════════════
' PACKAGE : Exercices & Planification
' ═══════════════════════════════════════════════════
package "Exercices & Planification" {

  class Exercice {
    + id : UUID
    + numero : Integer
    + titre : String
    + bloc : String
    + niveau : String
    + indicateurCognitif : String
    + alignementTestDigital : String
    + objectifCognitif : String
    + materiel : String
    + tacheMotrice : String
    + stimulusType : String
    + stimulusDetail : JSON
    + regleReponse : String
    + series : Integer
    + dureeSerie : String
    + recuperationSecondes : Integer
    + sourceScientifique : String
    + active : Boolean
    --
    + afficherDetails() : void
  }

  class PlanEntrainement {
    + id : UUID
    + coachId : UUID
    + joueurId : UUID
    + exerciceId : UUID
    + scheduledDate : DateTime
    + completed : Boolean
    + createdAt : DateTime
    --
    + marquerComplet() : void
  }

  class SessionPlanifiee {
    + id : UUID
    + coachId : UUID
    + joueurId : UUID
    + testType : String
    + sessionCategory : String
    + scheduledAt : DateTime
    + status : String
    + exerciceIds : UUID[]
    --
    + notifierJoueur() : void
  }

  Coach "1" --> "0..*" SessionPlanifiee : assigne
  Coach "1" --> "0..*" PlanEntrainement : crée
  Joueur "1" --> "0..*" PlanEntrainement : suit
  PlanEntrainement "0..*" --> "1" Exercice : référence
  ScoreSGS "1" --> "0..*" Exercice : recommande
}

' ═══════════════════════════════════════════════════
' PACKAGE : Notifications
' ═══════════════════════════════════════════════════
package "Notifications" {

  class Notification {
    + id : UUID
    + userId : UUID
    + type : String
    + title : String
    + message : String
    + sessionType : String
    + metadata : JSON
    + read : Boolean
    + createdAt : DateTime
    --
    + marquerLue() : void
  }

  Utilisateur "1" --> "0..*" Notification : reçoit
}

' ═══════════════════════════════════════════════════
' Relations inter-packages
' ═══════════════════════════════════════════════════
Joueur "1" --> "0..*" Session : passe
Coach "1" --> "0..*" Session : supervise

@enduml

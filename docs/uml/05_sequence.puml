@startuml CogniRaja_Sequence

skinparam backgroundColor #FAFAFA
skinparam SequenceLifeLineBorderColor #2D6A4F
skinparam SequenceLifeLineBackgroundColor #D8F3DC
skinparam SequenceParticipantBorderColor #1B4332
skinparam SequenceParticipantBackgroundColor #B7E4C7
skinparam SequenceActorBorderColor #1B4332
skinparam SequenceActorBackgroundColor #D8F3DC
skinparam SequenceArrowColor #40916C
skinparam SequenceDividerBorderColor #74C69D
skinparam SequenceDividerBackgroundColor #F0FFF4
skinparam NoteBackgroundColor #F0FFF4
skinparam NoteBorderColor #95D5B2
skinparam SequenceGroupBorderColor #52B788
skinparam SequenceGroupBackgroundColor #ECFDF5
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CogniRaja — Diagramme de Séquence\nScénario : Un joueur passe la batterie complète et reçoit ses recommandations

' ── Participants ──────────────────────────────────────────────────────
actor "Joueur\n(Navigateur)" as Player
participant "Application\nReact" as ReactApp
participant "SessionManager" as SM
participant "SimonEngine" as SE
participant "NBackEngine" as NE
participant "TMTEngine" as TE
participant "SGSEngine" as SGS
participant "Supabase\n(Auth + DB)" as SB

' ═════════════════════════════════════════════════════════════════════
== 1. Authentification ==
' ═════════════════════════════════════════════════════════════════════

Player -> ReactApp : Accède à l'application (URL)
activate ReactApp

ReactApp -> SB : getSession() — vérifier JWT
activate SB
SB --> ReactApp : { session, user } ou null
deactivate SB

alt Session expirée ou absente
  ReactApp --> Player : Rediriger → /login
  Player -> ReactApp : Soumettre email + mot de passe
  ReactApp -> SB : signInWithPassword({ email, password })
  activate SB
  SB --> ReactApp : { session: JWT, user }
  deactivate SB
end

ReactApp -> SB : SELECT role FROM profiles WHERE id = user.id
activate SB
SB --> ReactApp : { role: "player" }
deactivate SB

ReactApp --> Player : Afficher /app/home (layout joueur)

' ═════════════════════════════════════════════════════════════════════
== 2. Initialisation de la session ==
' ═════════════════════════════════════════════════════════════════════

Player -> ReactApp : Cliquer "Démarrer une session"
ReactApp -> SB : INSERT INTO sessions_test\n{ joueur_id, status: 'pending', created_at }
activate SB
SB --> ReactApp : { id: sessionId }
deactivate SB

ReactApp -> SM : initSession(sessionId, joueurId)
activate SM

SM --> ReactApp : État : "instructions"
ReactApp --> Player : Afficher écran instructions Simon Task

' ═════════════════════════════════════════════════════════════════════
== 3. Test 1 — Simon Task ==
' ═════════════════════════════════════════════════════════════════════

Player -> ReactApp : Cliquer "Commencer"
ReactApp -> SM : startTest("simon")
SM -> SE : initialiser(config)
activate SE
SE --> SM : Prêt (liste essais générés)

loop Pour chaque essai (N essais)
  SE --> ReactApp : Afficher stimulus\n(flèche + position gauche/droite)
  ReactApp --> Player : Stimulus affiché + chronomètre
  Player -> ReactApp : Appuyer touche (gauche/droite)
  ReactApp -> SE : enregistrerReponse(touche, timestamp)
  SE --> ReactApp : Résultat essai { correct, rt }
end

SE -> SE : calculerMetriques()\n→ avgRT, simonEffect, accuracy
SE --> SM : ResultatSimon\n{ avgRT, simonEffect, accuracy }
deactivate SE

SM -> SB : INSERT INTO resultats_test\n{ session_id, test_type: 'simon',\n  metrique: 'simon_effect', valeur,\n  details: { avg_rt, accuracy } }
activate SB
SB --> SM : OK
deactivate SB

SM --> ReactApp : État : "transition"
ReactApp --> Player : Afficher écran de transition\n(résumé partiel + pause)

' ═════════════════════════════════════════════════════════════════════
== 4. Test 2 — N-Back 2 ==
' ═════════════════════════════════════════════════════════════════════

Player -> ReactApp : Cliquer "Test suivant"
ReactApp -> SM : startTest("nback")
SM -> NE : initialiser({ n: 2, nbStimuli })
activate NE
NE --> SM : Prêt (séquence stimuli générée)

loop Pour chaque stimulus
  NE --> ReactApp : Afficher lettre/position
  ReactApp --> Player : Stimulus visible
  alt Joueur détecte une correspondance N-Back
    Player -> ReactApp : Appuyer "Match"
    ReactApp -> NE : enregistrerReponse("match", timestamp)
  else Joueur ne répond pas
    ReactApp -> NE : enregistrerReponse(null, timestamp)
  end
  NE --> ReactApp : Résultat { hit, miss, falseAlarm }
end

NE -> NE : calculerMetriques()\n→ accuracy, targetErrorRate, dPrime
NE --> SM : ResultatNBack\n{ accuracy, targetErrorRate, dPrime }
deactivate NE

SM -> SB : INSERT INTO resultats_test\n{ session_id, test_type: 'nback',\n  metrique: 'target_error_rate', valeur,\n  details: { accuracy, d_prime } }
activate SB
SB --> SM : OK
deactivate SB

SM --> ReactApp : État : "transition"
ReactApp --> Player : Afficher écran de transition

' ═════════════════════════════════════════════════════════════════════
== 5. Test 3 — Trail Making Test (TMT A+B) ==
' ═════════════════════════════════════════════════════════════════════

Player -> ReactApp : Cliquer "Test suivant"
ReactApp -> SM : startTest("tmt")
SM -> TE : initialiser({ partieA: true, partieB: true })
activate TE
TE --> SM : Prêt (cercles positionnés)

group Partie A (1 → 2 → 3 → ... → 25)
  loop Pour chaque connexion Partie A
    TE --> ReactApp : Afficher cercles numérotés
    ReactApp --> Player : Canevas interactif
    Player -> ReactApp : Toucher le prochain cercle
    ReactApp -> TE : enregistrerConnexion(cible, timestamp)
    TE --> ReactApp : Résultat connexion
  end
  TE --> SM : timeA (ms)
end

group Partie B (1 → A → 2 → B → 3 → C → ...)
  loop Pour chaque connexion Partie B
    TE --> ReactApp : Afficher cercles mélangés
    ReactApp --> Player : Canevas interactif
    Player -> ReactApp : Toucher la prochaine cible
    ReactApp -> TE : enregistrerConnexion(cible, timestamp)
    TE --> ReactApp : Résultat connexion
  end
  TE --> SM : timeB (ms)
end

TE -> TE : calculerMetriques()\n→ timeA, timeB, ratioBA = timeB/timeA
TE --> SM : ResultatTMT\n{ timeA, timeB, ratioBA }
deactivate TE

SM -> SB : INSERT INTO resultats_test\n{ session_id, test_type: 'tmt',\n  metrique: 'ratio_ba', valeur,\n  details: { time_a, time_b } }
activate SB
SB --> SM : OK
deactivate SB

' ═════════════════════════════════════════════════════════════════════
== 6. Calcul du Score Global Synthétique (SGS) ==
' ═════════════════════════════════════════════════════════════════════

SM -> SGS : computeSGS({ simon, nback, tmt })
activate SGS

note over SGS
  5 dimensions calculées :
  • reactionTime  (11%) ← normalizeRT(avgRT)
  • inhibition    (17%) ← normalizeSimonEffect(simonEffect)
  • workingMemory (22%) ← normalizeNBackAccuracy(accuracy)
  • attention     (22%) ← normalizeTimeA(timeA)
  • flexibility   (28%) ← normalizeRatioBA(ratioBA)
  SGS global = somme pondérée (0-100)
end note

SGS --> SM : SGSResult\n{ global, dimensions[] }
deactivate SGS

SM -> SB : UPDATE sessions_test\nSET score_global = SGS.global\nWHERE id = sessionId
activate SB
SB --> SM : OK
deactivate SB

SM -> SB : Trigger recompute_sgs_global()\n(vérification cohérence PostgreSQL)
SB --> SM : score_global confirmé
deactivate SB

' ═════════════════════════════════════════════════════════════════════
== 7. Génération des recommandations d'exercices ==
' ═════════════════════════════════════════════════════════════════════

SM -> SGS : genererRecommandations(dimensions)
activate SGS
note right of SGS
  Règles seuils :
  • flexibility < seuil → indicateur_cognitif LIKE '%Flexibilité%'
  • workingMemory < seuil → indicateur_cognitif LIKE '%Mémoire%'
  • inhibition < seuil → indicateur_cognitif LIKE '%Inhibiteur%'
  • reactionTime < seuil → indicateur_cognitif LIKE '%Réaction%'
end note
SGS --> SM : dimensionsLow[] (clés dimensions faibles)
deactivate SGS

SM -> SB : SELECT * FROM exercices\nWHERE active = true\nAND indicateur_cognitif ILIKE '%{dimension}%'
activate SB
SB --> SM : Exercice[] (triés par niveau)
deactivate SB

SM --> ReactApp : État : "final-results"\n{ sgsResult, exercicesRecommandes }
deactivate SM

' ═════════════════════════════════════════════════════════════════════
== 8. Affichage des résultats finaux ==
' ═════════════════════════════════════════════════════════════════════

ReactApp --> Player : Afficher SessionResultsScreen :\n• Score SGS global (gauge)\n• Radar des 5 dimensions cognitives\n• Statuts : excellent/normal/limite/faible\n• Exercices recommandés avec détails

alt Joueur souhaite exporter le rapport PDF
  Player -> ReactApp : Cliquer "Exporter PDF"
  ReactApp -> ReactApp : PDFExportEngine.generer()\n(html2canvas + jsPDF)
  ReactApp --> Player : Téléchargement rapport PDF
end

Player -> ReactApp : Consulter l'historique (/app/history)
ReactApp -> SB : SELECT sessions_test, resultats_test\nWHERE joueur_id = user.id\nORDER BY created_at DESC
activate SB
SB --> ReactApp : Historique des sessions + scores SGS
deactivate SB
ReactApp --> Player : Afficher graphiques d'évolution SGS\n(Recharts — tendances temporelles)

deactivate ReactApp

@enduml

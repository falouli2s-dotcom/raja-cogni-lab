@startuml CogniRaja_Composants

skinparam backgroundColor #FAFAFA
skinparam ComponentBorderColor #1B4332
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentStyle rectangle
skinparam ArrowColor #40916C
skinparam NoteBackgroundColor #F0FFF4
skinparam NoteBorderColor #95D5B2
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBorderColor #74C69D
skinparam packageBackgroundColor #F8FFF9
skinparam InterfaceBorderColor #2D6A4F
skinparam InterfaceBackgroundColor #B7E4C7
skinparam DatabaseBorderColor #1B4332
skinparam DatabaseBackgroundColor #D8F3DC
skinparam CloudBorderColor #52B788
skinparam CloudBackgroundColor #F0FFF4

title CogniRaja — Diagramme de Composants

' ═══════════════════════════════════════════════════
' CLIENT : Navigateur
' ═══════════════════════════════════════════════════
node "Navigateur Web / Mobile" as Browser {

  package "Application React 19 + TypeScript" as ReactApp {

    ' Routing
    component "TanStack Router\n(File-based)" as Router
    component "Middleware Auth\n(beforeLoad)" as AuthMiddleware

    ' UI Layouts
    component "Layout Joueur\n(_app.tsx)" as PlayerLayout
    component "Layout Coach\n(coach.tsx)" as CoachLayout
    component "Layout Admin\n(admin/)" as AdminLayout

    ' Moteurs de tests
    package "Moteurs Cognitifs" as Engines {
      component "SimonEngine\n(simon-engine.ts)" as SimonEngine
      component "NBackEngine\n(nback-engine.ts)" as NBackEngine
      component "TMTEngine\n(tmt-engine.ts)" as TMTEngine
      component "SGSEngine\n(sgs-engine.ts)" as SGSEngine
    }

    ' Gestionnaire de session
    component "SessionManager\n(session-manager.tsx)" as SessionManager

    ' Composants UI tests
    package "Composants Tests" as TestsUI {
      component "SimonTask UI" as SimonUI
      component "NBack UI" as NBackUI
      component "TMT UI" as TMTUI
      component "SessionResultsScreen" as ResultsScreen
    }

    ' Espace Joueur
    package "Pages Joueur (/app/*)" as PlayerPages {
      component "Accueil (home)" as HomePlayer
      component "Sessions" as SessionsPlayer
      component "Historique" as HistoryPlayer
      component "Exercices" as ExercisesPlayer
      component "Profil" as ProfilPlayer
    }

    ' Espace Coach
    package "Pages Coach (/coach/*)" as CoachPages {
      component "Dashboard" as DashboardCoach
      component "Roster Joueurs" as RosterCoach
      component "Profil Joueur" as PlayerProfileCoach
      component "Sessions Coach" as SessionsCoach
    }

    ' Espace Admin
    package "Pages Admin (/admin/*)" as AdminPages {
      component "Gestion Coaches" as AdminCoaches
    }

    ' Data fetching
    component "TanStack Query\n(React Query)" as ReactQuery
    component "React Hook Form\n+ Zod" as Forms
    component "Recharts\n(Graphiques SGS)" as Charts
    component "PDF Export Engine\n(jsPDF + html2canvas)" as PDFEngine

    ' Client Supabase
    component "Supabase Client\n(@supabase/supabase-js)" as SupabaseClient

    ' UI Kit
    package "UI Kit" {
      component "shadcn/ui\n(Radix UI)" as ShadcnUI
      component "Tailwind CSS v4" as Tailwind
      component "Framer Motion" as FramerMotion
    }
  }
}

' ═══════════════════════════════════════════════════
' CLOUDFLARE WORKERS (CDN + Edge)
' ═══════════════════════════════════════════════════
cloud "Cloudflare Workers\n(Edge Network)" as CF {
  component "Worker Runtime\n(wrangler.jsonc)" as CFWorker
  component "Static Asset Serving\n(dist/)" as CFStatic
}

' ═══════════════════════════════════════════════════
' SUPABASE BACKEND
' ═══════════════════════════════════════════════════
node "Supabase (Backend as a Service)" as Supabase {

  component "Auth Service\n(JWT + Sessions)" as SupaAuth
  database "PostgreSQL\n(Base de données)" as SupaDB {
    component "profiles" as TProfile
    component "sessions_test" as TSession
    component "resultats_test" as TResult
    component "exercices" as TExercice
    component "planning" as TPlanning
    component "sessions_planifiees" as TSessPlannifiee
    component "coach_players" as TCoachPlayers
    component "notifications" as TNotif
  }
  component "Row Level Security\n(RLS Policies)" as RLS
  component "Realtime\n(Subscriptions)" as Realtime
  component "Edge Functions\n(Triggers SQL)" as EdgeFunctions

  note right of EdgeFunctions
    Triggers actifs :
    • notify_player_on_session_planned
    • recompute_sgs_global()
    • deduplicate_completed_exercises
  end note
}

' ── Interfaces exposées ───────────────────────────
interface "REST / PostgREST API" as IPostgREST
interface "Auth API" as IAuth
interface "Realtime WS" as IRT

Supabase -up- IPostgREST
Supabase -up- IAuth
Supabase -up- IRT

' ═══════════════════════════════════════════════════
' DÉPENDANCES INTERNES
' ═══════════════════════════════════════════════════

' Router → Layouts
Router --> PlayerLayout
Router --> CoachLayout
Router --> AdminLayout
Router --> AuthMiddleware

' AuthMiddleware ↔ SupabaseClient
AuthMiddleware --> SupabaseClient

' SessionManager orchestre les moteurs
SessionManager --> SimonEngine
SessionManager --> NBackEngine
SessionManager --> TMTEngine
SessionManager --> SGSEngine
SessionManager --> TestsUI

' Moteurs → UI
SimonEngine --> SimonUI
NBackEngine --> NBackUI
TMTEngine --> TMTUI
SGSEngine --> ResultsScreen

' Data fetching
PlayerLayout --> ReactQuery
CoachLayout  --> ReactQuery
ReactQuery   --> SupabaseClient

' PDFEngine
PDFEngine --> Charts

' ═══════════════════════════════════════════════════
' DÉPENDANCES EXTERNES
' ═══════════════════════════════════════════════════

' Navigateur → Cloudflare
Browser ..> CF : HTTPS (chargement app)

' Cloudflare → Build
CF --> CFStatic : distribue
CFStatic ..> ReactApp : sert

' Client Supabase → Interfaces Supabase
SupabaseClient --> IPostgREST : appels REST (CRUD)
SupabaseClient --> IAuth      : authentification
SupabaseClient --> IRT        : subscriptions temps réel

' RLS filtre toutes les requêtes DB
IPostgREST --> RLS
RLS --> SupaDB

' Triggers DB → Notifications
EdgeFunctions --> TNotif
EdgeFunctions --> TSession

@enduml
